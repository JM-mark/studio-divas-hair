---
import '../styles/global.css';
import cg300 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-normal.woff2?url';
import cg300x from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-ext-300-normal.woff2?url';
import cg500 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import cg500x from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-ext-500-normal.woff2?url';
import cg400 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import cg400x from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-ext-400-normal.woff2?url';
import cg400i from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-italic.woff2?url';
import cg400ix from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-ext-400-italic.woff2?url';
import mr from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import mrx from '@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2?url';
import { business, hours, schemaDayNames, serviceGroups } from '../data/site';
import { withBase } from '../lib/url';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;

// Astro.site is the origin only; withBase() adds the '/studio-divas-hair' base path (Astro.url.pathname already includes it).
const origin = Astro.site!.origin;
const homeUrl = origin + withBase('');
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = origin + withBase('images/og-image.jpg');

// Self-hosted fonts, Latin + Latin-Ext (Portuguese needs only Latin; Ext covers names and symbols).
const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const EXT = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const face = (family: string, style: string, weight: string, url: string, range: string) =>
  `@font-face{font-family:'${family}';font-style:${style};font-weight:${weight};font-display:swap;src:url(${url}) format('woff2');unicode-range:${range}}`;
const fontCss = [
  face('Cormorant Garamond', 'normal', '300', cg300, LATIN), face('Cormorant Garamond', 'normal', '300', cg300x, EXT),
  face('Cormorant Garamond', 'normal', '400', cg400, LATIN), face('Cormorant Garamond', 'normal', '400', cg400x, EXT),
  face('Cormorant Garamond', 'normal', '500', cg500, LATIN), face('Cormorant Garamond', 'normal', '500', cg500x, EXT),
  face('Cormorant Garamond', 'italic', '400', cg400i, LATIN), face('Cormorant Garamond', 'italic', '400', cg400ix, EXT),
  face('Manrope', 'normal', '200 800', mr, LATIN), face('Manrope', 'normal', '200 800', mrx, EXT),
].join('');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  '@id': `${homeUrl}#salon`,
  name: business.legalTitle,
  description,
  url: homeUrl,
  image: ogImage,
  logo: origin + withBase('icon-512.png'),
  telephone: [business.phoneE164, business.phoneSecondaryE164],
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.state,
    postalCode: business.address.zip,
    addressCountry: business.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: business.geo.lat, longitude: business.geo.lng },
  openingHoursSpecification: hours
    .filter((h) => h.open && h.close)
    .map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: schemaDayNames[h.day], opens: h.open, closes: h.close })),
  aggregateRating: { '@type': 'AggregateRating', ratingValue: business.rating.value.toFixed(1), reviewCount: business.rating.count, bestRating: '5' },
  hasMap: business.mapsUrl,
  sameAs: [business.mapsUrl, business.instagramUrl],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Serviços',
    itemListElement: serviceGroups.map((g) => ({
      '@type': 'OfferCatalog',
      name: g.title,
      itemListElement: g.items.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, description: s.description } })),
    })),
  },
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#14070c" />

    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="icon" href={withBase('favicon-16.png')} sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Studio Diva's Hair, salão de beleza unissex em Indaiatuba" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" as="font" type="font/woff2" href={cg300} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={cg400i} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={mr} crossorigin />
    <style is:inline set:html={fontCss}></style>
    <slot name="head" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a href="#conteudo" class="skip">Pular para o conteúdo</a>
    <slot />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
