---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { publishedCredits } from '../data/image-credits';
---
<Layout title="Créditos das imagens | Studio Diva's Hair" description="Origem das imagens usadas no site do Studio Diva's Hair." noindex>
  <Header />
  <main id="conteudo" class="container-x section">
    <h1 class="t-h1 text-plum-800">Créditos das imagens</h1>
    <p class="mt-5 max-w-2xl text-lg text-wood-700">O logo, os ícones e as ilustrações da marca foram criados para o Studio Diva's Hair. {publishedCredits.length === 0 ? 'Por enquanto o site não usa fotos de terceiros nem de bancos de imagens.' : 'Fotos usadas no site:'}</p>
    {publishedCredits.length > 0 && (
      <div class="mt-10 overflow-x-auto">
        <table class="w-full min-w-[32rem] text-left">
          <thead><tr class="bg-sand-100"><th class="px-3 py-3">Imagem</th><th class="px-3 py-3">Origem</th><th class="px-3 py-3">Uso no site</th></tr></thead>
          <tbody>
            {publishedCredits.map((c) => (
              <tr><td class="px-3 py-3">{c.file}</td><td class="px-3 py-3"><a class="link" href={c.url} target="_blank" rel="noopener">{c.source}</a></td><td class="px-3 py-3">{c.usedIn}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </main>
  <Footer />
</Layout>
