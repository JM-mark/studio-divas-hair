---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { bookingAnchor } from '../data/site';
import { withBase } from '../lib/url';
---
<Layout title="Página não encontrada | Studio Diva's Hair" description="A página que você procura não foi encontrada." noindex>
  <Header solid />
  <main id="conteudo" class="page">
    <div class="wrap">
      <h1>Ops, essa página <em>não existe</em></h1>
      <p class="lead">Mas o nosso atendimento está a um toque de distância.</p>
      <div class="page__btns">
        <a href={withBase('')} class="btn btn--line">Voltar ao início</a>
        <a href={withBase('') + bookingAnchor} class="btn btn--gold"><Icon name="calendar" />Agendar horário</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
