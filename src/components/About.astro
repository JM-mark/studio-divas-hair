---
import Pic from './Pic.astro';
import { about, aboutPoints } from '../data/site';
import { photoCredits } from '../data/image-credits';
const alt = photoCredits.find((c) => c.key === 'sobre')!.alt;
---
<section id="sobre" class="about">
  <div class="wrap">
    <div class="about__grid">
      <div class="reveal">
        <div class="about__media">
          <span class="about__frame" aria-hidden="true"></span>
          <Pic name="sobre" kind="card" alt={alt} sizes="(min-width:900px) 40vw, 90vw" />
          <div class="about__tag"><b>Centro</b>Indaiatuba · SP</div>
        </div>
        <p class="about__note">Imagem ilustrativa de um salão de beleza.</p>
      </div>
      <div class="about__text">
        <div class="head reveal" style="margin-bottom:0">
          <span class="eyebrow">Sobre o studio</span>
          <h2 class="section-title">{about.title[0]}<em>{about.title[1]}</em></h2>
        </div>
        {about.paragraphs.map((p) => <p class="reveal">{p}</p>)}
        <div class="diffs">
          {aboutPoints.map((d, i) => (
            <div class="diff reveal" style={`--d:${0.05 * (i + 1)}s`}><i></i><div><strong>{d.title}</strong><span>{d.text}</span></div></div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
