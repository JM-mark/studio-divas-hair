---
import Icon from './Icon.astro';
import { business, heroReview, whatsappLink } from '../data/site';
import { withBase } from '../lib/url';
const ratingText = business.rating.value.toFixed(1).replace('.', ',');
const m = (f: string) => withBase(`media/${f}`);
---
<section class="hero" id="inicio">
  <div class="hero__media" id="heroMedia" data-video-d={m('hero-desktop.mp4')} data-video-m={m('hero-mobile.mp4')}>
    <picture>
      <source media="(min-width:900px)" type="image/avif" srcset={m('hero-poster-d.avif')} />
      <source media="(min-width:900px)" type="image/webp" srcset={m('hero-poster-d.webp')} />
      <source type="image/avif" srcset={m('hero-poster-m.avif')} />
      <source type="image/webp" srcset={m('hero-poster-m.webp')} />
      <img src={m('hero-poster-m.webp')} alt="Mulher de costas com cabelo longo, liso e muito brilhante (imagem ilustrativa)" width="720" height="1280" fetchpriority="high" decoding="async" />
    </picture>
    <video id="heroVideo" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture></video>
  </div>
  <div class="wrap hero__inner">
    <div class="hero__grid">
      <div>
        <p class="hero__eyebrow cas" style="--d:.1s">Indaiatuba · São Paulo</p>
        <h1>
          <span class="ln cas" style="--d:.25s">Cabelo lindo</span>
          <span class="ln cas" style="--d:.4s">começa no</span>
          <span class="ln cas" style="--d:.55s"><em>cuidado</em></span>
        </h1>
        <p class="hero__sub cas" style="--d:.75s">Salão unissex no Centro de Indaiatuba: corte, escova, progressiva, hidratação, unhas e estética, com um atendimento que começa escutando você.</p>
        <div class="hero__actions cas" style="--d:.95s">
          <a class="btn btn--gold" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" />Agendar pelo WhatsApp</a>
          <a class="btn btn--ghost" href={business.instagramUrl} target="_blank" rel="noopener"><Icon name="instagram" />Instagram</a>
        </div>
      </div>
      <aside class="proof cas" id="proof" style="--d:1.15s" aria-label="Avaliação no Google">
        <div class="proof__top">
          <span class="proof__score">{ratingText}</span>
          <div>
            <span class="stars" role="img" aria-label="5 estrelas">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</span>
            <p class="proof__meta">{business.rating.count} avaliações no Google</p>
          </div>
        </div>
        <q>{heroReview.quote}</q>
        <p class="proof__by">— {heroReview.author} · avaliação no Google</p>
      </aside>
    </div>
  </div>
</section>
