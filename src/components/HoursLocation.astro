---
import Icon from './Icon.astro';
import { business, hours, fullAddress, mapsDirectionsUrl, mapsEmbedUrl, whatsappLink } from '../data/site';
---
<section id="contato" class="location">
  <div class="wrap">
    <div class="head reveal">
      <span class="eyebrow">Localização</span>
      <h2 class="section-title">Venha nos <em>visitar</em></h2>
    </div>
    <div class="loc__grid">
      <div class="loc__info reveal">
        <p id="open-status" class="open-pill" role="status" aria-live="polite">
          <span id="open-dot" class="dot" aria-hidden="true"></span>
          <span id="open-text">Confira nossos horários</span>
        </p>
        <div class="info-row"><span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.4"/></svg></span>
          <div><h3>Endereço</h3><address style="font-style:normal"><p>{fullAddress}</p></address></div></div>
        <div class="info-row"><span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg></span>
          <div><h3>Horário</h3>
            <table class="hours" id="hours-table" data-hours={JSON.stringify(hours)}>
              <caption class="sr-only">Horário de funcionamento</caption>
              <tbody>
                {hours.filter((h) => h.day !== 0).map((h) => (
                  <tr data-day={h.day}>
                    <th scope="row">{h.label}<span class="today-tag"></span></th>
                    <td>{h.open ? `${h.open} – ${h.close}` : 'Fechado'}</td>
                  </tr>
                ))}
              </tbody>
            </table></div></div>
        <div class="info-row"><span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg></span>
          <div><h3>Telefone / WhatsApp</h3><p><a class="tel" href={`tel:${business.phoneE164}`}>{business.phoneDisplay}</a> · <a class="tel" href={`tel:${business.phoneSecondaryE164}`}>{business.phoneSecondaryDisplay}</a></p></div></div>
        <div class="loc__btns">
          <a class="btn btn--gold" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" />Agendar</a>
          <a class="btn btn--line" href={mapsDirectionsUrl} target="_blank" rel="noopener"><Icon name="pin" />Como chegar</a>
        </div>
      </div>
      <div class="map reveal" style="--d:.1s">
        <iframe title={`Mapa: ${business.name}, ${business.address.street}`} src={mapsEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  import { openStatus, saoPauloNow, type HourRow } from '../lib/hours';

  const table = document.getElementById('hours-table')!;
  const hours: HourRow[] = JSON.parse(table.dataset.hours!);

  function update() {
    const now = saoPauloNow();
    const { open, closesAt } = openStatus(hours, now);
    // The static HTML has no "today" marker: only the current day (São Paulo time) gets one, client-side.
    table.querySelectorAll<HTMLElement>('tr').forEach((tr) => {
      const isToday = Number(tr.dataset.day) === now.day;
      tr.classList.toggle('is-today', isToday);
      tr.querySelector('.today-tag')!.textContent = isToday ? ' (hoje)' : '';
    });
    document.getElementById('open-text')!.textContent = open ? `Aberto agora · fecha às ${closesAt}` : 'Fechado agora';
    document.getElementById('open-dot')!.classList.toggle('is-open', open);
  }
  update();
  setInterval(update, 60_000);
</script>
