---
import Icon from './Icon.astro';
import Pic from './Pic.astro';
import { serviceGroups, serviceCards, bookingAnchor } from '../data/site';
import { withBase } from '../lib/url';
import { photoCredits } from '../data/image-credits';
const alt = (key: string) => photoCredits.find((c) => c.key === key)!.alt;
---
<section id="servicos" class="services">
  <div class="wrap">
    <div class="head head--center reveal">
      <span class="eyebrow">Nossos serviços</span>
      <h2 class="section-title">Cabelo, unhas e estética para <em>mulheres e homens</em></h2>
      <p class="section-lead">Chame no WhatsApp para agendar e consultar o valor de cada serviço.</p>
    </div>
    <div class="svc-grid">
      {serviceCards.map((card, i) => {
        const group = serviceGroups.find((g) => g.id === card.id)!;
        return (
          <article class="svc reveal" style={`--d:${i * 0.08}s`} aria-labelledby={`svc-${card.id}`}>
            <Pic name={card.key} kind="card" alt={alt(card.key)} class="svc__bg" sizes="(min-width:900px) 33vw, 100vw" />
            <div class="svc__body">
              <p class="svc__no">0{i + 1}</p>
              <h3 id={`svc-${card.id}`}>{card.title[0]}{card.title[1] && <em>{card.title[1]}</em>}</h3>
              <p class="svc__line">{card.line}</p>
              <ul class="chips" data-chips aria-label={`Serviços de ${card.ask}`}>
                {group.items.map((s, k) => <li style={`--n:${Math.max(0, k - 5)}`}>{s.name}</li>)}
              </ul>
              <button class="chips__toggle" type="button" data-chips-toggle hidden aria-expanded="false">Ver todos os serviços</button>
              <a class="btn btn--gold" href={withBase('') + bookingAnchor} data-book data-book-category={card.id}>
                <Icon name="calendar" />Agendar<span class="sr-only"> {card.ask}</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
