---
import Icon from './Icon.astro';
import { serviceGroups, whatsappLink } from '../data/site';
---
<section id="servicos" class="section">
  <div class="container-x">
    <div class="reveal max-w-3xl">
      <h2 class="h2">Cabelo, unhas e estética para mulheres e homens</h2>
      <p class="mt-5 max-w-2xl text-lg text-wood-700">Escova, progressiva, hidratação e matização em Indaiatuba, além de manicure, alongamento de unhas, maquiagem e depilação no Centro. Chame no WhatsApp e consulte o valor.</p>
    </div>
    <div class="mt-14 grid gap-x-12 gap-y-14 lg:grid-cols-[1.35fr_1fr_1fr]">
      {serviceGroups.map((g, i) => (
        <section class="reveal" style={`--d:${i * 90}ms`} aria-labelledby={`g-${g.id}`}>
          <h3 id={`g-${g.id}`} class="text-[2rem] text-plum-800">{g.title}</h3>
          <p class="mt-1 text-wood-700">{g.intro}</p>
          <ul class="mt-6 space-y-5">
            {g.items.map((s) => (
              <li>
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h4 class="text-[1.075rem] font-semibold">{s.name}</h4>
                    <p class="text-[0.95rem] text-wood-700">{s.description}</p>
                    {s.price && <p class="mt-1 font-semibold text-plum-800">{s.price}</p>}
                  </div>
                  <a href={whatsappLink(`Olá! Gostaria de consultar o valor de ${s.name} no Studio Diva's Hair.`)} target="_blank" rel="noopener"
                     class="link inline-flex min-h-11 shrink-0 items-center gap-1 text-[0.95rem] text-plum-800">
                    Consultar valor<span class="sr-only"> de {s.name} pelo WhatsApp</span><Icon name="arrow" class="h-4 w-4" />
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>
