---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { business, gallery, features } from '../data/site';

// Lazy glob: the photos are not bundled (nor published) unless the flag is on.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/images/galeria-*.jpg');
// Gallery photos are only loaded when the flag is on (they are not committed until the owner confirms rights).
const tiles = features.showClientPhotos ? await Promise.all(gallery.map(async (g) => ({ ...g, meta: (await files[`../assets/images/${g.file}`]()).default }))) : [];
---
<section id="instagram" class="on-dark section bg-ink-900 text-cream-100">
  <div class:list={['container-x grid items-center gap-12 lg:gap-20', features.showClientPhotos && 'lg:grid-cols-[1fr_1fr]']}>
    <div class="reveal">
      <h2 class="h2">Acompanhe o dia a dia no Instagram</h2>
      <p class="mt-5 max-w-lg text-[1.1rem] text-sand-300">Trabalhos recentes, dicas de cuidado e novidades do estúdio. Siga para não perder nada.</p>
      <p class="mt-8 font-display text-[clamp(1.5rem,3.4vw,2.4rem)] leading-tight text-cream-100">{business.instagramHandle}</p>
      <a href={business.instagramUrl} target="_blank" rel="noopener" class="btn btn-rose mt-8"><Icon name="instagram" /> Seguir no Instagram</a>
    </div>
    {features.showClientPhotos && <ul class="reveal grid grid-cols-2 gap-3" style="--d:100ms">
      {tiles.map((t) => (
        <li class="zoom overflow-hidden bg-ink-700">
          <a href={business.instagramUrl} target="_blank" rel="noopener" aria-label={`${t.alt} (abrir o Instagram)`} class="block">
            <Image src={t.meta} alt={t.alt} widths={[240, 400, 600]} sizes="(min-width: 1024px) 24vw, 46vw" loading="lazy" class="aspect-square w-full object-cover" />
          </a>
        </li>
      ))}
    </ul>}
  </div>
</section>
