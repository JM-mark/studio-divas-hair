---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { withBase } from '../lib/url';
import { business, fullAddress, hours, mapsDirectionsUrl, bookingPath } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <a href={withBase('')} class="logo" aria-label="Studio Diva's Hair, início"><Logo alt="" height={64} /></a>
        <p style="margin-top:18px;max-width:320px">Salão de beleza unissex no Centro de Indaiatuba, com atendimento personalizado em cada visita.</p>
      </div>
      <div>
        <h2>Contato</h2>
        <address>
          <p>{fullAddress}</p>
          <p><a class="tel" href={`tel:${business.phoneE164}`}>{business.phoneDisplay}</a> · <a class="tel" href={`tel:${business.phoneSecondaryE164}`}>{business.phoneSecondaryDisplay}</a></p>
          <p><a href={withBase(bookingPath)} style="text-decoration:underline;text-underline-offset:3px">Agendar horário</a></p>
          <p><a href={mapsDirectionsUrl} target="_blank" rel="noopener" style="text-decoration:underline;text-underline-offset:3px">Como chegar</a></p>
        </address>
        <div class="social" style="margin-top:12px"><a href={business.instagramUrl} target="_blank" rel="noopener"><Icon name="instagram" />{business.instagramHandle}</a></div>
      </div>
      <div>
        <h2>Horários</h2>
        <ul class="footer__hours">
          {hours.filter((h) => h.open).map((h) => <li>{h.label}: {h.open} às {h.close}</li>)}
          <li>Segunda: fechado</li>
        </ul>
      </div>
    </div>
    <div class="footer__copy">
      <p>© {year} {business.name}. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
