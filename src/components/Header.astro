---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { navLinks, whatsappLink } from '../data/site';
import { withBase } from '../lib/url';
interface Props { solid?: boolean }
const { solid = false } = Astro.props;
const home = withBase('');
---
<header class:list={['header', { 'header--solid': solid }]} id="header">
  <div class="wrap">
    <a href={home} class="logo" aria-label="Studio Diva's Hair – início"><Logo alt="" height={46} /></a>
    <nav class="nav" aria-label="Principal">
      {navLinks.map((l) => <a href={home + l.href}>{l.label}</a>)}
    </nav>
    <div class="header__cta">
      <a class="btn btn--gold btn--sm" href={whatsappLink()} target="_blank" rel="noopener">
        <Icon name="whatsapp" /><span class="long">Agendar pelo WhatsApp</span><span class="short">Agendar</span>
      </a>
      <button class="burger" id="burger" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="drawer"><span></span></button>
    </div>
  </div>
</header>
<div class="drawer" id="drawer" aria-hidden="true">
  {navLinks.map((l) => <a class="dl" href={home + l.href}>{l.label}</a>)}
  <a class="btn btn--gold" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" />Agendar pelo WhatsApp</a>
</div>
