---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { business, navLinks, bookingAnchor } from '../data/site';
import { withBase } from '../lib/url';
interface Props { solid?: boolean }
const { solid = false } = Astro.props;
const home = withBase('');
---
<header class:list={['header', { 'header--solid': solid }]} id="header">
  <div class="wrap">
    <a href={home} class="logo" aria-label="Studio Diva's Hair, início"><Logo alt="" height={46} priority /></a>
    <nav class="nav" aria-label="Principal">
      {navLinks.map((l) => <a href={home + l.href}>{l.label}</a>)}
    </nav>
    <div class="header__cta">
      <a class="btn btn--gold btn--lux" href={home + bookingAnchor} data-book aria-label="Agendamentos"><Icon name="calendar" class="lux__ico" /><span class="lux__t">Agendamentos</span></a>
      <a class="icon-btn icon-btn--line" href={business.instagramUrl} target="_blank" rel="noopener" aria-label="Instagram do Studio Diva's Hair"><Icon name="instagram" /></a>
      <button class="burger" id="burger" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="drawer"><span></span></button>
    </div>
  </div>
</header>
<div class="drawer" id="drawer" aria-hidden="true">
  {navLinks.map((l, i) => <a class="dl" href={home + l.href} style={`--i:${i}`}>{l.label}</a>)}
  <div class="drawer__social" style={`--i:${navLinks.length}`}>
    <a class="btn btn--gold btn--lux" href={home + bookingAnchor} data-book>Agendamentos</a>
    <a class="btn btn--ghost" href={business.instagramUrl} target="_blank" rel="noopener"><Icon name="instagram" />Instagram</a>
  </div>
</div>
