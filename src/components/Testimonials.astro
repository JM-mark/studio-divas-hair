---
import Icon from './Icon.astro';
import { business, testimonials } from '../data/site';
const ratingText = business.rating.value.toFixed(1).replace('.', ',');
---
<section id="avaliacoes" class="reviews">
  <div class="wrap">
    <div class="head head--center reveal">
      <span class="eyebrow">Depoimentos</span>
      <h2 class="section-title">Quem vem, <em>volta e recomenda</em></h2>
      <p class="section-lead">Avaliações de clientes no Google. Nota {ratingText} em {business.rating.count} avaliações.</p>
    </div>
  </div>
  <div class="wrap">
    <div class="track" id="track" tabindex="0" aria-label="Depoimentos de clientes">
      {testimonials.map((t) => (
        <figure class="quote">
          <span class="stars" role="img" aria-label="5 de 5 estrelas">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</span>
          <blockquote>{t.quote}</blockquote>
          <figcaption class="quote__by"><span class="quote__av" aria-hidden="true">{t.author[0]}</span><div><b>{t.author}</b><small>Avaliação no Google · {t.when}</small></div></figcaption>
          {t.reply && <p class="quote__reply"><strong>Resposta do estúdio:</strong> {t.reply}</p>}
        </figure>
      ))}
    </div>
    <div class="ctrl" id="ctrl">
      <div class="dots" id="dots" aria-hidden="true"></div>
      <div class="arrows">
        <button class="arrow" id="prev" type="button" aria-label="Depoimento anterior"><svg viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
        <button class="arrow" id="next" type="button" aria-label="Próximo depoimento"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </div>
    </div>
    <p class="reviews__more reveal"><a class="btn btn--line" href={business.mapsUrl} target="_blank" rel="noopener">Ver as {business.rating.count} avaliações no Google</a></p>
  </div>
</section>
