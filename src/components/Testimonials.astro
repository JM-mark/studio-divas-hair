---
import Icon from './Icon.astro';
import { business, testimonials } from '../data/site';
const ratingText = business.rating.value.toFixed(1).replace('.', ',');
---
<section id="avaliacoes" class="section">
  <div class="container-x">
    <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <h2 class="h2 max-w-xl">Quem vem, volta — e recomenda</h2>
      <p class="flex items-center gap-4">
        <span class="font-display text-6xl leading-none text-plum-800">{ratingText}</span>
        <span class="flex flex-col leading-snug">
          <span class="flex text-plum-800" aria-hidden="true">{[0,1,2,3,4].map(() => <Icon name="star" class="h-5 w-5" />)}</span>
          <span class="font-semibold">{business.rating.count} avaliações no Google</span>
        </span>
      </p>
    </div>
    <ul class="mt-12 grid gap-12 lg:grid-cols-3 lg:gap-10">
      {testimonials.map((t, i) => (
        <li class="reveal flex flex-col" style={`--d:${i * 90}ms`}>
          <span class="flex text-plum-800" role="img" aria-label="5 de 5 estrelas">{[0,1,2,3,4].map(() => <Icon name="star" class="h-5 w-5" />)}</span>
          <blockquote class="mt-4 flex-1 font-display text-[1.45rem] leading-snug text-ink-900">“{t.quote}”</blockquote>
          <p class="mt-5 font-semibold text-plum-800">{t.author}</p>
          <p class="text-sm text-wood-700">Avaliação no Google · {t.when}</p>
          {t.reply && <p class="mt-4 bg-sand-100 p-4 text-[0.95rem] text-wood-700"><strong class="text-plum-800">Resposta do estúdio:</strong> {t.reply}</p>}
        </li>
      ))}
    </ul>
    <p class="reveal mt-14">
      <a href={business.mapsUrl} target="_blank" rel="noopener" class="btn btn-ink">Ver avaliações no Google</a>
    </p>
  </div>
</section>
